# Port the gateway listens on
PORT=8787

# Devin API credentials and base URL
DEVIN_API_KEY=apk_replace_me
DEVIN_API_BASE=https://api.devin.ai

# Polling tuning (milliseconds)
DEVIN_POLL_INTERVAL_MS=3000
DEVIN_POLL_TIMEOUT_MS=600000

# Optional bearer token clients must send to call this gateway.
# Leave empty to disable auth (NOT recommended in production).
GATEWAY_API_KEY=

# Logging
LOG_LEVEL=info
